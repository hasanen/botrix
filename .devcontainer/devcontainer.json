{
  "name": "Botrix Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {},
  "postCreateCommand": "rustup component add rustfmt clippy && rustup target add wasm32-unknown-unknown",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ]
    }
  },
  "forwardPorts": [8080, 3000],
  "remoteUser": "container"
}
