{
  "name": "botrix",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "GIT_EDITOR": "vim"
  },
  "postCreateCommand": "sh .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
