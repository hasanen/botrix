# Keep the build context small and the image reproducible.

# Build output. A stale local frontend `dist/` must never be merged into the
# image; the Containerfile builds it from source.
target
**/target
crates/botrix-frontend/dist

# VCS, CI, editor, and container tooling
.git
.github
.devcontainer
.vscode
.kiro

# Local runtime data and secrets
dev-data
dev-config
*.db
*.db-shm
*.db-wal
.env
.env.*

# Documentation is not needed to build the binary
docs
*.md
