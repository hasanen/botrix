# Local development environment. Copy to .env (git-ignored):
#   cp .env.example .env
# Values are plain KEY=VALUE (no quotes, no export): the file is read by
# `podman run --env-file` and `podman exec --env-file`.
# These are throwaway development values. Never reuse them in production.

# Required by `botrix serve`. Session secret must be at least 32 characters
# and the two values should differ.
BOTRIX_SESSION_SECRET=dev-session-secret-change-me-0123456789
BOTRIX_CRYPTO_PASSPHRASE=dev-crypto-passphrase-change-me-0123456789

# Accept session cookies over plain http://localhost.
BOTRIX_INSECURE_COOKIES=1

# Log level.
RUST_LOG=info,botrix_server=debug
